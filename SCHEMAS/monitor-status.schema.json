{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-collab/monitor-status",
  "title": "MonitorStatus",
  "description": "ai-collab 看板状态结构（项目级）",
  "type": "object",
  "required": [
    "project_id",
    "generated_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "description": "项目唯一标识"
    },
    "project_name": {
      "type": "string",
      "description": "项目显示名称"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "状态生成时间"
    },
    "current_stage": {
      "type": "string",
      "description": "当前阶段"
    },
    "stages": {
      "type": [
        "array",
        "null"
      ],
      "description": "阶段流水线（null 等价于空数组）",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "in_progress",
              "pending",
              "blocked"
            ]
          },
          "actor": {
            "type": "string"
          }
        }
      }
    },
    "envelopes": {
      "type": "array",
      "description": "信封泳道",
      "items": {
        "type": "object",
        "required": [
          "envelope_id",
          "from",
          "to",
          "action",
          "status"
        ],
        "properties": {
          "envelope_id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "evidence_summary": {
      "type": "object",
      "description": "证据统计",
      "properties": {
        "total": {
          "type": "integer"
        },
        "pass": {
          "type": "integer"
        },
        "conditional": {
          "type": "integer"
        },
        "fail": {
          "type": "integer"
        },
        "blocked": {
          "type": "integer"
        },
        "security": {
          "type": "integer"
        }
      }
    },
    "audit_count": {
      "type": "integer",
      "description": "审计记录数"
    },
    "active_claims": {
      "type": "array",
      "description": "活跃租约",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "actor_id",
          "action",
          "expires_at"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "description": "Actor 状态",
      "items": {
        "type": "object",
        "required": [
          "actor_id",
          "role",
          "status"
        ],
        "properties": {
          "actor_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "malformed_inputs": {
      "type": "integer",
      "description": "损坏/无法解析的输入计数"
    }
  },
  "additionalProperties": true
}
