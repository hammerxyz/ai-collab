{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-collab/actor-profile",
  "title": "ActorProfile",
  "description": "ai-collab Agent 能力声明结构",
  "type": "object",
  "required": ["actor_id", "role", "ai_ide", "model"],
  "properties": {
    "actor_id": {
      "type": "string",
      "description": "Actor 唯一标识，格式：{ROLE}_{IDE}_{MODEL}",
      "pattern": "^(SPEC|IMPL|TEST|WATCHDOG)_[A-Z0-9_]+$"
    },
    "role": {
      "type": "string",
      "enum": ["SPEC", "IMPL", "TEST", "WATCHDOG"],
      "description": "协作角色"
    },
    "ai_ide": {
      "type": "string",
      "description": "AI IDE 名称"
    },
    "model": {
      "type": "string",
      "description": "底层模型名称"
    },
    "capabilities": {
      "type": "object",
      "description": "能力声明",
      "properties": {
        "languages": {
          "type": "array",
          "items": { "type": "string" },
          "description": "支持的编程语言"
        },
        "runtime": {
          "type": "array",
          "items": { "type": "string" },
          "description": "支持的运行时环境"
        },
        "max_context_tokens": {
          "type": "integer",
          "description": "最大上下文 token 数"
        },
        "timer_supported": {
          "type": "boolean",
          "description": "是否支持定时器"
        },
        "parallel_sessions": {
          "type": "integer",
          "minimum": 1,
          "description": "最大并行会话数"
        }
      }
    },
    "preferences": {
      "type": "object",
      "description": "偏好设置",
      "properties": {
        "commit_style": { "type": "string" },
        "test_first": { "type": "boolean" },
        "max_file_lines_per_edit": { "type": "integer" }
      }
    },
    "constraints": {
      "type": "object",
      "description": "约束条件",
      "properties": {
        "no_python_runtime": { "type": "boolean" },
        "no_docker": { "type": "boolean" },
        "max_edit_scope": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
