{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-collab/heartbeat",
  "title": "Heartbeat",
  "description": "ai-collab Actor 心跳结构",
  "type": "object",
  "required": ["actor_id", "role", "status", "last_seen"],
  "properties": {
    "actor_id": {
      "type": "string",
      "description": "Actor 唯一标识"
    },
    "role": {
      "type": "string",
      "enum": ["SPEC", "IMPL", "TEST", "WATCHDOG"],
      "description": "协作角色"
    },
    "status": {
      "type": "string",
      "enum": ["online", "idle", "offline"],
      "description": "Actor 状态"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "最近活动时间"
    },
    "current_task": {
      "type": "string",
      "description": "当前正在处理的任务标识"
    },
    "session_id": {
      "type": "string",
      "description": "当前会话标识"
    }
  },
  "additionalProperties": true
}
